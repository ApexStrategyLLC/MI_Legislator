<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="6.0" method="upgrade" client="administrator">
    <name>com_milegislator</name>
    <author>MI Legislature Lookup</author>
    <creationDate>2024-09-01</creationDate>
    <copyright>Copyright (C) 2024</copyright>
    <license>GPL-2.0-or-later</license>
    <version>1.0.0</version>
    <description>MI Legislator Lookup with district search, party balance, and AJAX endpoints.</description>

    <scriptfile>src/Extension/MilegislatorComponent.php</scriptfile>

    <administration>
        <access>access.xml</access>
        <menu link="index.php?option=com_milegislator" view="legislators">MI Legislators</menu>
        <submenu>
            <menu link="index.php?option=com_milegislator" view="legislators">Legislators</menu>
        </submenu>
        <files>
            <filename>access.xml</filename>
            <filename>milegislator.php</filename>
            <folder>src</folder>
            <folder>language</folder>
            <folder>sql</folder>
        </files>
        <languages>
            <language tag="en-GB">language/en-GB/en-GB.com_milegislator.ini</language>
            <language tag="en-GB">language/en-GB/en-GB.com_milegislator.sys.ini</language>
        </languages>
        <config>
            <fields name="params">
                <fieldset name="basic">
                    <field name="enable_api" type="radio" default="1" label="Enable AJAX API" description="Allow frontend AJAX lookups" class="btn-group btn-group-yesno">
                        <option value="1">JYES</option>
                        <option value="0">JNO</option>
                    </field>
                </fieldset>
            </fields>
        </config>
    </administration>

    <site>
        <files folder="../../components/com_milegislator">
            <filename>milegislator.php</filename>
            <folder>src</folder>
            <folder>language</folder>
        </files>
        <languages>
            <language tag="en-GB">../../components/com_milegislator/language/en-GB/en-GB.com_milegislator.ini</language>
        </languages>
    </site>

    <install>
        <sql>
            <file driver="mysql" charset="utf8mb4">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8mb4">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>

    <languages>
        <language tag="en-GB">language/en-GB/en-GB.com_milegislator.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.com_milegislator.sys.ini</language>
    </languages>
</extension>
